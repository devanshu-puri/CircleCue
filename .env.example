ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/circlecue
JWT_SECRET=change-this-secret-in-production-32-chars
TZ_DEFAULT=UTC

# AI Configuration (Gemma via OpenAI-compatible endpoint or local Ollama)
AI_PROVIDER=openai_compat
AI_BASE_URL=https://your-do-gpu-droplet:8000/v1
AI_MODEL=gemma-3-4b-it  # TODO(verify): confirm on DO droplet
AI_API_KEY=
AI_TIMEOUT_S=8.0

# Temporal Workflows
TEMPORAL_ADDRESS=your-temporal-cloud:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_API_KEY=
TEMPORAL_ENABLED=false

# Monitoring & Diagnostics
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
DEMO_CLOCK=true
PREDICTOR_PROVIDER=stub
ALLOWED_HOSTS=localhost,127.0.0.1,circlecue-api.onrender.com
